18:08:01 read(4, "#include <stdio.h>\n#include <stdlib.h>\n\n// Global variable (initialized) \342\206\222 .data\nint global_data = 42;\n\n// Global variable (uninitialized) \342\206\222 .bss\nint global_bss;\n\n// Constant string \342\206\222 .rodata\nconst char *message = \"Hello from .rodata!\";\n\n// Static local variable \342\206\222 stored in .data (not .bss, since it's initialized)\nvoid counter() {\n    static int count = 0;\n    count++;\n    printf(\"Counter: %d\\n\", count);\n}\n\n// Destructor function \342\206\222 .fini_array\n__attribute__((destructor)) void finalize() {\n    printf(\"Finalizing...\\n\");\n}\n\n// Constructor function \342\206\222 .init_array\n__attribute__((constructor)) void initialize() {\n    printf(\"Initializing...\\n\");\n}\n\n// Function in .text\nvoid print_message() {\n    printf(\"%s\\n\", message); // Uses PLT/GOT for printf\n}\n\nint main() {\n    // Local static variable \342\206\222 stored in .data (initialized)\n    static int local_static = 100;\n    \n    printf(\"Global Data: %d\\n\", global_data);\n    printf(\"Global BSS: %d\\n\", global_bss);\n    printf(\"Local Static: %d\\n\", local_static);\n    \n    print_message();\n    \n    for (int i = 0; i < 3; i++) {\n        counter(); // Modifies static variable in .data\n    }\n\n    return 0;\n}", 1163) = 1163
